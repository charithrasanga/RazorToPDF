@page
@model RazorToPDF.Views.StudentInfoPrintViews.EducationHistory._EducationHistoryPartialModel
@{
}

<div class="page-padding">
    <div class="element-bottom-gap mt-4">
        <div class="col">
            <label class="form-label">
                Student's current GPA
            </label>
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 1, InputPlaceholder = "" })
        </div>
    </div>

    <div class="element-bottom-gap">
        <label class="form-label"><span class="text-danger">* </span>On average, how much time in spent is spent on homework each weekday?</label>
        <div class="print-row checkbox-label">
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "None" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Up to 1 hour" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "1-2 hours" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "2-3 hours" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "3-4 hours" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "More than 4 hours" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Don't Know" })
        </div>
    </div>

    <div class="element-bottom-gap">
        <label class="form-label"><span class="text-danger">* </span>Typically, how often do you have to tell the student to tell the students to do homework? </label>
        <div class="print-row checkbox-label">
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Always" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Sometimes" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Rarely" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Never" })
            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Don't know" })
        </div>
    </div>

    <div class="element-bottom-gap">
        <label class="form-label"><span class="text-danger">* </span>How satisfied are you with the student in the following? </label>
        <div class="print-row mb-2" style="14px">
            <div class="ash-box-satisfaction">
                @await Html.PartialAsync("~/Views/Shared/UI/PrintSatisfactionSelector/_PrintSatisfactionSelectorPartial.cshtml", new RazorToPDF.Views.Shared.UI.PrintSatisfactionSelector._PrintSatisfactionSelectorPartialModel { SatisfactionArea = "Reading Comprihension" })
            </div>
            <div class="blue-box-satisfaction">
                @await Html.PartialAsync("~/Views/Shared/UI/PrintSatisfactionSelector/_PrintSatisfactionSelectorPartial.cshtml", new RazorToPDF.Views.Shared.UI.PrintSatisfactionSelector._PrintSatisfactionSelectorPartialModel { SatisfactionArea = "Phonics/ Fluency/ Spelling" })
            </div>
        </div>
        <div class="print-row mb-2" style="14px">
            <div class="blue-box-satisfaction">
                @await Html.PartialAsync("~/Views/Shared/UI/PrintSatisfactionSelector/_PrintSatisfactionSelectorPartial.cshtml", new RazorToPDF.Views.Shared.UI.PrintSatisfactionSelector._PrintSatisfactionSelectorPartialModel { SatisfactionArea = "Math" })
            </div>
            <div class="ash-box-satisfaction">
                @await Html.PartialAsync("~/Views/Shared/UI/PrintSatisfactionSelector/_PrintSatisfactionSelectorPartial.cshtml", new RazorToPDF.Views.Shared.UI.PrintSatisfactionSelector._PrintSatisfactionSelectorPartialModel { SatisfactionArea = "Writing" })
            </div>
        </div>
        <div class="print-row mb-2" style="14px">
            <div class="blue-box-satisfaction">
                @await Html.PartialAsync("~/Views/Shared/UI/PrintSatisfactionSelector/_PrintSatisfactionSelectorPartial.cshtml", new RazorToPDF.Views.Shared.UI.PrintSatisfactionSelector._PrintSatisfactionSelectorPartialModel { SatisfactionArea = "Study skills" })
            </div>
            <div class="ash-box-satisfaction">
                @await Html.PartialAsync("~/Views/Shared/UI/PrintSatisfactionSelector/_PrintSatisfactionSelectorPartial.cshtml", new RazorToPDF.Views.Shared.UI.PrintSatisfactionSelector._PrintSatisfactionSelectorPartialModel { SatisfactionArea = "Motivation" })
            </div>
        </div>
        <div class="print-row" style="14px">
            <div class="ash-box-satisfaction">
                @await Html.PartialAsync("~/Views/Shared/UI/PrintSatisfactionSelector/_PrintSatisfactionSelectorPartial.cshtml", new RazorToPDF.Views.Shared.UI.PrintSatisfactionSelector._PrintSatisfactionSelectorPartialModel { SatisfactionArea = "Confidence" })
            </div>
        </div>
    </div>

    <div class="element-bottom-gap">
        <div class="blue-box">
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">Has the student ever repeated one or more grades?</label>
                    <div class="print-row checkbox-label">
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Yes" })
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "No" })
                    </div>
                </div>

                <div class="col mb-3">
                    <label class="form-label">
                        Which grade(s)?
                    </label>
                    @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 1, InputPlaceholder = "" })
                </div>

                <div class="col">
                    <label class="form-label">
                        Why?
                    </label>
                    @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 15, InputPlaceholder = "" })
                </div>
            </div>
        </div>
    </div>

    <div class="element-bottom-gap">
        <div class="ash-box">
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">Does the student have a learning disability?</label>
                    <div class="print-row checkbox-label">
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Yes" })
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "No" })
                    </div>
                </div>

                <div class="col">
                    <label class="form-label">
                        What's the learning disability?
                    </label>
                    @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 15, InputPlaceholder = "" })
                </div>
            </div>


        </div>
    </div>

    <div class="element-bottom-gap">
        <div class="blue-box">
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">Does the student receive any remedial or related services from the school?</label>
                    <div class="print-row checkbox-label">
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Yes" })
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "No" })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">If yes, what is the service? (Check all that apply)</label>
                    <div class="checkbox-label d-flex flex-column mb-3">
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Individualized Education Plan(IEP)" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "504 Olan" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Plan" })
                        </div>
                    </div>
                    @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 15, InputPlaceholder = "" })
                </div>

                <div>
                    <label class="form-label">Services and Accomodations (Check all that apply)</label>
                    <div class="checkbox-label">
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Student gets extra time for testing" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Student gets prewritten notes in class" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Special class placement at front of class" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Student can use a device to accommodate learning (computer, speller, etc...)" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Strudent has tests read aloud" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Student can retest as needed" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Student is in pull out programs to receive extra help" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Student has adjusted homework assignments" })
                        </div>
                        <div class="mb-2">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Student has a behaviour log" })
                        </div>
                        <div">
                            @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Other" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="page-padding">
    <div class="element-bottom-gap">
        <div class="blue-box">
            <div class="p-3">
                <div>
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 15, InputPlaceholder = "" })
                    <p class="italic-style mt-1" style="font-size: 5px !important">Please bring a copy of the student's (IEP/ 504) plan to the conference if available.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="element-bottom-gap">
        <div class="ash-box">
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">Has the student been tutored?</label>
                    <div class="print-row checkbox-label">
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "Yes" })
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintCheckboxPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintCheckboxPartialModel { LabelName = "No" })
                    </div>
                </div>

                <div class="col mb-3">
                    <label class="form-label">
                        From whom?
                    </label>
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 15, InputPlaceholder = "" })
                </div>

                <div class="col">
                    <label class="form-label">
                        What subject(s) were tutored?
                    </label>
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 15, InputPlaceholder = "" })
                </div>
            </div>
        </div>
    </div>

    <div class="element-bottom-gap">
        <div class="col">
            <label class="form-label">
                Any other comments
            </label>
                        @await Html.PartialAsync("~/Views/Shared/UI/_PrintTextareaPartial.cshtml", new RazorToPDF.Views.Shared.UI._PrintTextareaPartialModel { Rows = 15, InputPlaceholder = "" })
        </div>
    </div>
</div>


