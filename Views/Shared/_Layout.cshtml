<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <title>HLC</title>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" rel="stylesheet">
      <style>
        
        @@page{
            size: 595px 842px; /*  this configurations will picked up by pupateersharp and use for printing */
        }

        html {
            font-size: 0.5rem;
                
        }
        
        body{
            overflow-x: hidden;
        }
        p,
        span,
        label,
        li,th, td, div {
            font-family:Montserrat !important;
            accent-color: #475061;
        }
        a{
            color: blue;
        }
        .full-width-div {
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }
        .container_padding{
            padding-left: 0;
            padding-right: 0;
        }
        .form-label {
            font-size: 7px;
            font-weight: 700;
            color: #475061;
            margin-bottom: 0px; 
        }
        .checkbox-label{
            font-size: 7px;
            font-weight: 400;
            color: #475061; 
        }
        .heading_size{
            font-size: 18px;
            font-weight: 300;
            color: #475061;
        }
        .sub-heading{
            font-size: 18px;
            font-weight: 200;
            color: #475061;
        }
        .sentense-line{
            font-size: 14px;
            font-weight: 200;
            color: #475061;
        }
        .italic_font{
            font-size: 16px;
            font-weight: 100;
            font-style: italic;
            color: #475061af;
        }
        .table-font-size {
            font-size: 12.8px;
        }
        .normal_font{
            font-size: 16px;
            font-weight: 100;
            color: #475061 !important;
        }
        .list_size{
            font-size: 16px;
            font-weight: 200;
            color: #475061;
        }
        .list-points{
            font-size: 14px;
            font-weight: 200;
        }

        .form-control {
            border: 0.5px solid #1d1f21;
            background-color: white;
            border-radius: 1px;
            resize: none;
            font-size: 7px;
            line-height: 8.53px;
            padding: 5px 6px 5px 6px;
        }

        input[type='checkbox']:after {
            box-shadow: none !important;
        }
  
        .form-check-input[type='checkbox'] {
            appearance: none; /* This hides the default checkbox */
            border: 0.5px solid #1D1F21;
            border-radius: 1px !important;
            width: 8.5px;
            height: 8.5px;
        }

        .form-check-input[type='checkbox']:checked {
            background-color: transparent !important; /* This hides the default checkmark */
        }

        .form-check-input[type='checkbox']:checked:after {
            content: "";
            display: block;
            width: 3.5px;
            height: 6.5px;
            border: solid #1D1F21;
            border-width: 0 1px 1px 0;
            transform: rotate(45deg);
            position: relative;
            left: 2px; /* Adjust this value to move the checkmark to the right */
        }

        @@media print {
            .pagebreak {
                clear: both;
                page-break-after: always;
            }
            .myContainer {
            display: grid;
            page-break-inside: avoid;
        }
        }

        .noto-color-emoji-regular {
            font-family: "Noto Color Emoji", sans-serif;
            font-weight: 400;
            font-style: normal;
        }

        html {
            -webkit-print-color-adjust: exact;
        }


        /* Newly added ---------------------------------------------- */

        .LCTestAdministration{
            thead {
                tr {
                    th {                       
                        text-align: center ;
                        vertical-align: middle ;
                        height: 53px
                    }
                }
            }
            tbody {
                tr {
                    td {
                        text-align: center ;
                        vertical-align: middle ;
                        height: 53px
                    }
                    td:first-child {
                        text-align: start ;
                        padding-left: 10px
                    }
                }
            }   
            tfoot{
                tr{
                    td{
                        text-align: center !important;
                        vertical-align: middle !important;
                        height: 53px;
                    }
                }
            }
        }

        .table-2{
            thead

        {
            tr

        {
            th

        {
            text-align: center;
            vertical-align: middle;
            height: 33px
        }

        }
        }

        body {
            tr

        {
            td

        {
            text-align: start;
            vertical-align: middle;
            height: 33px
        }

        }
        }
        }

        .table-3{
            thead {
                tr {
                    th {                       
                        text-align: center ;
                        vertical-align: middle ;
                        height: 53px
                    }
                }
            }
            tbody {
                tr {
                    td {
                        text-align: center ;
                        vertical-align: middle ;
                        height: 53px
                    }
                }
            }  
        }
        .testWidth{
            width: 26%;
        }
        .checkWidth{
            width: 19%;
        }
        .dataWidth{
            width: 18%;
        }

        .green_line {
            width: 7px;
            height: 1px;
            margin: 15px 10px;
            border: 1px solid #BED9C2;
            border-radius: 4px;
            position: relative;
            top: -10px;
            left: -15px;
        }

        .blue_box{
            background-color: rgba(200, 237, 243, 0.219);
            border-left-width: 5px !important;
            border-radius: 5px;
            border-left-color: rgba(200, 237, 243, 0.856) !important ;
        }
        .ash_box{
            background-color: rgba(200, 237, 243, 0);
            border-left-width: 5px !important;
            border-radius: 5px;
        }

        .margin_left{
            margin-left: 50px;
        }

        .paddingEdit{
            padding-left: 10px;
        }

        .print-row {
            display: flex;
            flex-direction: row;
            gap: 2.5mm;
        }

/*         Newly added while creating CCH Print
 */
        .form-title {
            margin-bottom: 2.5mm;
            p

            {
                font-size: pt;
                font-weight: 600;
                line-height: 1;
            }

            div {
                width: 20px;
                height: 1px;
                border-top: 2px solid $accent-green;
            }

        }

        .italic-style{
            font-size: 7px;
            font-weight:400;
            font-style: italic;
            color: #818991;
            margin-bottom: 2px;
        }

        .sibling-table {
            font-size: 7px;
            font-weight: 400;
            width: 100%;
            thead

            {
                tr

                {
                    border: 0.5px solid #1D1F21;
                    background-color: #FFFFFF;
                    th

                    {
                        padding-top: 6px;
                        padding-bottom: 6px;
                        span

                            {
                                font-size: 7pt;
                                font-weight: 400;
                            }

                        &:first-child {
                            padding-left: 10px;
                        }

                    }
                }
            }

            tbody {
                tr

                {
                    border-left: 1px solid #1D1F21;
                    border-right: 1px solid #1D1F21;
                    border-bottom: 1px solid #1D1F21;
                    td

                    {
                        span

                        {
                            font-size: 7px;
                            font-weight: 400;
                        }

                        &:first-child {
                            padding-left: 10px;
                        }

                    }
                }
            }
        }

        .default-data-row {
            border: 1px solid #1d1f21;
            td

            {
                span

                {
                    padding: 10px;
                }

            }
        }

        .page-padding {
            padding: 0 40px 0px 40px;
        }

        .element-bottom-gap {
            margin-bottom: 12px;
            page-break-inside: avoid;
        }

        .form-check {
            margin-bottom: 0;
        }

        /* For Print Satisfaction Selector */

         /* For print satisfaction */
    
        .satisfaction-selector{
            padding: 8px;
            height: 73px;
            text-align: center;
        }

        .satisfaction-selector_without_heading {
            padding: 8px;
            height: 61px;
            text-align: center;
        }



        .satisfaction-selector__title{
            font-size: 7px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 2px;
            width: 200px;
            div
            {
                width: 7.5px;
                height: 2px;
                border-top: 1px solid #bed9c2;
                position:relative;
                top: -2px;
            }
        }

        .satisfaction-selector__container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 3px;
            input{
                border: 0.5px solid #1D1F21;
                width: 8.5px;
                height: 8.5px;
            }
        }

        .satisfaction-selector__container__image-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-around;
            background-color: #f6f6f6;
            width: 36px;
            height: 30px;
            border-radius: 2px;
            padding-bottom: 4px;
            position: relative;
            top: -2px;
            gap: 2px;
            
            span{
                font-size: 4px;
                font-weight: 500;
                color: #475061;
                line-height: 4.88px;
                position: relative;
                width: 24px;
                top: 2px;
            }
        }

        .satisfaction-selector__wrapper {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 2px;
            position: relative;
            top:0px
        }

        .satisfaction-selector__container__svg__container {
            svg {
                width: 6.5mm;
                height: 6.5mm;
                display: inline-block;
                box-sizing: border-box;
                background: inherit;
                background-color: inherit;
                position: relative;
                top: 2px;
            }
        }

        /* For Print Subject Card */

        .subject-card {
            font-family: Montserrat !important;
            padding: 8px 10px 8px 8px;
            border-radius: 0.5rem;
            border: 1px solid #e5e6e6;
            color: #475061;
            margin-bottom:10px;
        }

        .subject-card-header {
            font-family: Montserrat !important;
            font-size: 7px;
            font-weight: 700;
            height: 8.53px;
        }

        .subject-card-form-label {
            font-size: 6px;
            font-weight: 700;
            margin-bottom: 0px;
        }
        
        .subject-card-input {
            border: 0.5px solid #1d1f21;
            background-color: white;
            border-radius: 1px;
            resize: none;
            font-size: 6px;
            font-weight: 400;
            line-height: 10px;
            padding: 5px 6px 5px 6px;
            width: 100%;
        }

        .subject-card-checkbox-label {
            font-size: 6px;
            font-weight: 400;
            color: #475061;
            margin-bottom: 2px;
        }

        .subject-card-checkbox {
            width: 100px;
        }

        .subject-card-ash-line {
            width: 7px;
            height: 1px;
            margin: 15px 10px;
            border: 1px solid #BED9C2;
            border-radius: 4px;
            position: relative;
            top: -10px;
            left: -15px;
        }

        .blue-box{
            border: 1px solid #E5E6E6;
            border-left: 2px solid #ADD9C5;
            border-radius: 2px;
        }

        .ash-box {
            border: 1px solid #E5E6E6;
            border-left: 2px solid #E5E6E6;
            border-radius: 2px;
        }

        .blue-box-satisfaction {
            border: 1px solid #E5E6E6;
            border-left: 2px solid #ADD9C5;
            border-radius: 2px;
            width: 250px;
        }

        .ash-box-satisfaction {
            border: 1px solid #E5E6E6;
            border-left: 2px solid #E5E6E6;
            border-radius: 2px;
            width: 250px;
        }

    </style>
</head>
<body>
    <div class="container-fluid">

        @RenderBody()
    </div>
    <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
    <script src="https://code.jquery.com/jquery-1.12.4.min.js" integrity="sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ" crossorigin="anonymous"></script>
    <!-- Include all compiled plugins (below), or include individual files as needed -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js" integrity="sha384-aJ21OjlMXNL5UyIl/XNwTMqvzeRMZH2w8c5cRVpzpU8Y5bApTppSuUkhZXN0VxHd" crossorigin="anonymous"></script>
</body>
</html>