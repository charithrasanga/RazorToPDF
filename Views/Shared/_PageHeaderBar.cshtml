@model RazorToPDF.Views.Shared._PageHeaderBarModel

<div class="row">
    <div style="height: 24px">
        <div style="background-color:#398842" class="full-width-div text-light px-3 py-2">
            <div class="d-flex flex-row font-title" style="margin-left: 35px;">
                <div class="d-flex align-items-center justify-content-center" style="width: 16px; height: 16px; border-radius: 50%; background-color: white; margin-right: 8px; margin-top:-2px">
                    <span class="fw-bold mt-1" style="color: black;">@Model.Number</span>
                </div>
                <p class="fw-bold mb-0" style="top: 2px">@Model.Title</p>
            </div>
        </div>
    </div>
</div>