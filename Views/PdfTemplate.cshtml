@await Html.PartialAsync("~/Views/Shared/_PageBreakPartial.cshtml")
@await Html.PartialAsync("~/Views/Shared/_PageHeaderBar.cshtml", new RazorToPDF.Views.Shared._PageHeaderBarModel { Title = "Student Education History", Number = "5" })

@* 5 Education History  *@
@await Html.PartialAsync("~/Views/StudentInfoPrintViews/EducationHistory/_EducationHistoryPartial.cshtml", new RazorToPDF.Views.StudentInfoPrintViews.EducationHistory._EducationHistoryPartialModel())

@await Html.PartialAsync("~/Views/Shared/_PageBreakPartial.cshtml")
@await Html.PartialAsync("~/Views/Shared/_PageHeaderBar.cshtml", new RazorToPDF.Views.Shared._PageHeaderBarModel { Title = "Student Tests", Number = "6" })

@* 6 Student Tests  *@
