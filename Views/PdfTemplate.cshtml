@using RazorToPDF.Services
@using RazorToPDF.ViewModels
@inject IMockStudentDetailService userService
@model GeneratePdfRequest
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var studentDetails = new StudentMockDataViewModel();
    if (Model.FillData)
    {
        studentDetails = userService.GetMockData();
    }
}

@await Html.PartialAsync("~/Views/Shared/_ReportHeaderPartial.cshtml", "STUDENT LC TEST ADMINISTRATION")
@await Html.PartialAsync("~/Views/Shared/_PageHeaderBar.cshtml", new RazorToPDF.Views.Shared._PageHeaderBarModel { Title = "Student Personal Information", Number = "1" })

@* 1 Student Personal Info  *@
@await Html.PartialAsync("~/Views/StudentInfoPrintViews/PersonalInfo/_PersonalInfoPartial.cshtml", new RazorToPDF.Views.StudentInfoPrintViews.PersonalInfo._PersonalInfoPartialModel())

@await Html.PartialAsync("~/Views/Shared/_PageBreakPartial.cshtml")
@await Html.PartialAsync("~/Views/Shared/_PageHeaderBar.cshtml", new RazorToPDF.Views.Shared._PageHeaderBarModel { Title = "Family Information", Number = "2" })

@* 2 Family Info  *@
@await Html.PartialAsync("~/Views/StudentInfoPrintViews/FamilyInfo/_FamilyInfoPartial.cshtml", new RazorToPDF.Views.StudentInfoPrintViews.FamilyInfo._FamilyInfoPartialModel())

@await Html.PartialAsync("~/Views/Shared/_PageBreakPartial.cshtml")
@await Html.PartialAsync("~/Views/Shared/_PageHeaderBar.cshtml", new RazorToPDF.Views.Shared._PageHeaderBarModel { Title = "Student Health History", Number = "3" })

@* 3 Health History  *@
@await Html.PartialAsync("~/Views/StudentInfoPrintViews/HealthHistory/_HealthHistoryPartial.cshtml", new RazorToPDF.Views.StudentInfoPrintViews.HealthHistory._HealthHistoryPartialModel())

