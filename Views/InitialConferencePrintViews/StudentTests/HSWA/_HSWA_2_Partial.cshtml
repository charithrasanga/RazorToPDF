@page
@using RazorToPDF.ViewModels
@model RazorToPDF.Views.InitialConferencePrintViews.HSWA._HSWA_2_PartialModel
@{
}

<div>
	<div>
		<p>
			<b> Goal:</b> Since Jane is in grade 6.0 (expressed as 'yrs.mths'), the expectation is for Jane to be able to recognize and read words through grade
			<b>7.0</b>, because we need to prepare Jane for next year's material.
		</p>
	</div>
	<div>
		<div style="width:500px; height:500px">
			<canvas id="myChart3" height="350" width="400"></canvas>
		</div>
	</div>
	<div>
		<p>
			<b>Goal met: Yes</b>
		</p>
		<p> Jane's sight word reading is at the <b>12.5</b> grade level, which is at or above the expected level. Jane is <b>5.5</b> grade levels above the goal. </p>
		<p><b>Conclusion:  </b>Jane's sight-word reading level is at or above where it needs to be for success in school. </p>
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var ctx = document.getElementById('myChart3').getContext('2d');
    var myChart3 = new Chart(ctx, {
        type: 'bar',  // Change this to the type of chart (bar, line, pie, etc.)
        data: {
            labels: ['January', 'February', 'March', 'April', 'May', 'June'],
            datasets: [{
                label: '# of Votes',
                data: [12, 19, 3, 5, 2, 3],
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(255, 159, 64, 0.2)'
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>